{
  "manifest_version": 3,
  "name": "recent-tab-switcher",
  "version": "1.0.0",
  "description": "直前に開いていたタブへショートカットキーで移動",
  "minimum_chrome_version": "102",
  "permissions": [
    "storage",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "switch-to-previous-tab": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "直前に開いていたタブへ移動"
    }
  }
}
